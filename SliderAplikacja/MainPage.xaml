<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SliderAplikacja.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Slider i Stepper" FontSize="26" HorizontalOptions="Center" />

            <Label Text="Ustaw temperaturę:" />

            <Slider x:Name="suwak" Minimum="0" Maximum="100" Value="20" ValueChanged="Suwak_ValueChanged" />

            <Label x:Name="wynikSuwaka" Text="Temperatura: 20°C" FontSize="20" />

            <Label Text="Ustaw liczbę osób:" />

            <Stepper x:Name="licznik" Minimum="1" Maximum="100" Increment="3" Value="1" ValueChanged="Licznik_ValueChanged" />

            <Label x:Name="wynikLicznika" Text="Liczba osób: 1" FontSize="20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
